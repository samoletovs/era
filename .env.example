# Azure Cosmos DB
COSMOS_ENDPOINT=https://era-dev-cosmos.documents.azure.com:443/
COSMOS_KEY=           # Only for local dev — production uses managed identity
COSMOS_DATABASE=era-db

# Azure OpenAI (for agent)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
